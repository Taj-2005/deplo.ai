# ════════════════════════════════════════════════════════════════════════════
# deplo.ai Server — Environment Variables
#
# ARCHITECTURE:
#
#   deplo.ai is a deployment ORCHESTRATION platform.
#   Users connect their own GitHub and Vercel accounts.
#   deplo.ai orchestrates deployments into the USER'S Vercel account.
#   Users own all projects, deployments, logs, and domains.
#
#   GitHub: user's identity + repo access (OAuth app owned by deplo.ai)
#   Vercel: user's OWN account (per-user OAuth token stored encrypted in DB)
#
#   deplo.ai credentials:
#     GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET  — deplo.ai's GitHub OAuth App
#     VERCEL_CLIENT_ID / VERCEL_CLIENT_SECRET  — deplo.ai's Vercel Integration App
#
#   Per-user tokens are stored encrypted in the ProviderConnection table.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Format: postgresql://user:password@host/dbname?sslmode=require
# Get this from: https://neon.tech → your project → Connection Details
# connect_timeout=15 matters: Neon auto-suspends when idle and takes ~5-10s to
# wake; Prisma's default 5s connect timeout causes P1001 on cold starts.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/deplo_db?sslmode=require&connect_timeout=15

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Format: rediss://default:password@host:port
# Get this from: https://console.upstash.com → your database → REST URL → Redis URL
REDIS_URL=rediss://default:your-upstash-password@your-db.upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-minimum-32-characters-long-random-string
JWT_EXPIRES_IN=7d

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# CREATE 2 APPS: one for dev, one for prod
#
# IMPORTANT: The callback URL must point to the FRONTEND domain, not the backend.
# The frontend proxies /api/* to this server via Next.js rewrites, so GitHub
# redirects the browser to the frontend and the user never sees the Render URL.
#
# How to create:
#   github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#
# DEV app settings:
#   Homepage URL:    http://localhost:3000
#   Callback URL:    http://localhost:3000/api/v1/auth/github/callback
#
# PROD app settings:
#   Homepage URL:    https://www.deplo.in
#   Callback URL:    https://www.deplo.in/api/v1/auth/github/callback   ← frontend (proxied)
#
# Scopes needed: read:user  user:email  repo  admin:repo_hook
GITHUB_CLIENT_ID=your-dev-app-client-id
GITHUB_CLIENT_SECRET=your-dev-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# ── Vercel Integration OAuth App (registered ONCE by deplo.ai) ───────────────
# These are deplo.ai's integration app credentials — NOT any user's token.
# Per-user Vercel tokens are obtained via OAuth and stored encrypted in the DB.
#
# How to create:
#   vercel.com → Dashboard → Integrations → Integration Console → Create
#   Set redirect URL: https://your-server.com/api/v1/integrations/vercel/callback
#   Set webhook URL:  https://your-server.com/api/v1/webhooks/vercel
#   After creating → copy Client ID + Client Secret from Credentials section
#
VERCEL_CLIENT_ID=your-vercel-integration-client-id
VERCEL_CLIENT_SECRET=your-vercel-integration-client-secret
VERCEL_INTEGRATION_SLUG=deplo-ai

# ── Public server URL (required in production) ────────────────────────────────
# This is the backend's OWN public URL (e.g. https://deplo-ai.onrender.com).
# Used for endpoints that EXTERNAL providers call directly and must NOT be
# proxied through the frontend:
#   - Vercel OAuth callback: PUBLIC_URL/api/v1/integrations/vercel/callback
#   - GitHub CI/CD webhooks: PUBLIC_URL/api/v1/webhooks/github
# Leave blank in local dev — OAuth and webhooks require a public HTTPS URL.
PUBLIC_URL=

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Used to validate inbound webhook signatures from GitHub and Vercel.
# Optional in dev (validation skipped). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# ── Render ────────────────────────────────────────────────────────────────────
# NO global Render credentials. Render is a per-user integration: each user
# pastes their own Personal API Key on the Integrations page; it is validated
# against GET /v1/owners and stored AES-256-GCM encrypted in ProviderConnection.
# Deployments always run inside the user's own Render workspace.

# ── Groq (Layer 3 AI reasoning fallback) ──────────────────────────────────────
# Optional — the analysis engine is deterministic-first and works without AI.
# When set, low-confidence detections escalate to Groq (max 2 calls/deployment:
# one repo reasoning + one failure diagnosis). Two keys: the client fails over
# to the second when the first is rejected (401/403/429/5xx).
# Get keys: https://console.groq.com → API Keys (free tier available)
GROQ_API_TOKEN_1=
GROQ_API_TOKEN_2=
# Production model with strict JSON-schema structured outputs (default shown)
# GROQ_MODEL=openai/gpt-oss-120b

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt GitHub + Vercel OAuth tokens before storing in the database.
# Must be exactly 64 hex characters (= 32 bytes = AES-256 key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate-64-hex-chars-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# NOTE: With the Vercel rewrite proxy, browser requests are same-origin to the
# frontend and reach this server via a server-side proxy hop, so CORS is mostly
# a secondary safeguard. The FIRST entry is also used as the base for OAuth
# redirect targets (e.g. `${ALLOWED_ORIGINS[0]}/auth/callback`), so keep the
# canonical frontend origin first.
ALLOWED_ORIGINS=http://localhost:3000,https://www.deplo.in,https://deplo.in

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | http | debug | silly
LOG_LEVEL=debug

# ── Deployment notification emails (SMTP) ─────────────────────────────────────
# Optional — the feature is OFF until SMTP_HOST, SMTP_USER and SMTP_PASS are
# all set. When enabled, users receive branded emails on:
#   • deployment FAILED  — AI explanation: what broke, which file, how to fix,
#     a copy-paste prompt for their AI coding tool, and prioritised issues
#     (security/dependency first)
#   • deployment SUCCEEDED — live production URLs
#   • WAITING_FOR_ENV — the exact variables the deployment needs to continue
#
# Works with any SMTP provider (Resend, Postmark, SES, Gmail app password…):
SMTP_HOST=
SMTP_PORT=587
# "true" only for implicit-TLS ports (465); leave unset/false for 587 STARTTLS
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to users (must be a domain your SMTP provider allows)
MAIL_FROM=deplo.ai <deploai201@gmail.com>

# Inbox that receives in-app feedback and bug reports from the dashboard
# widget. Falls back to SMTP_USER when unset. Mail arrives from MAIL_FROM
# with Reply-To set to the reporter, so replying answers them directly.
FEEDBACK_TO=deploai201@gmail.com
