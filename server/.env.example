# ════════════════════════════════════════════════════════════════════════════
# deplo.ai Server — Environment Variables
#
# HOW THIS WORKS (Architecture note):
#
#   deplo.ai is a PLATFORM that deploys on behalf of users.
#   Users authenticate with their GitHub account.
#   The platform then deploys their repos using deplo.ai's own
#   Vercel team and Render account (MVP model — "platform account").
#
#   GitHub: user's identity (OAuth app owned by deplo.ai)
#   Vercel: deplo.ai's OWN Vercel team/token (not the user's)
#   Render: deplo.ai's OWN Render account API key (not the user's)
#
#   In a future "per-user" model, Vercel/Render tokens would be stored
#   per-user in the database (encrypted). That requires Vercel OAuth app
#   setup and a UI for users to paste their Render API key.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Format: postgresql://user:password@host/dbname?sslmode=require
# Get this from: https://neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/deplo_db?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Format: rediss://default:password@host:port
# Get this from: https://console.upstash.com → your database → REST URL → Redis URL
REDIS_URL=rediss://default:your-upstash-password@your-db.upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-minimum-32-characters-long-random-string
JWT_EXPIRES_IN=7d

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# CREATE 2 APPS: one for dev, one for prod
#
# How to create:
#   github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#
# DEV app settings:
#   Homepage URL:    http://localhost:3000
#   Callback URL:    http://localhost:3000/api/v1/auth/github/callback
#   (proxied by Next.js to the API server — must match GITHUB_REDIRECT_URI exactly)
#
# PROD app settings:
#   Homepage URL:    https://deplo.ai.taj.works  (or your domain)
#   Callback URL:    https://your-render-server.onrender.com/api/v1/auth/github/callback
#
# Scopes needed: read:user  user:email  repo
GITHUB_CLIENT_ID=your-dev-app-client-id
GITHUB_CLIENT_SECRET=your-dev-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# ── Vercel (Platform Account — deplo.ai's OWN account) ───────────────────────
# This is NOT a user's token. This is deplo.ai's service account.
# All user apps are deployed under deplo.ai's Vercel team.
#
# How to get:
#   vercel.com → Account Settings → Tokens → Create Token
#   Name: "deplo-ai-server-dev"  Scope: Full Account
#
# VERCEL_TEAM_ID is optional — only needed if you're using a Vercel team.
#   vercel.com → Team Settings → General → Team ID
VERCEL_TOKEN=your-vercel-service-account-token
VERCEL_TEAM_ID=

# ── Render (Platform Account — deplo.ai's OWN account) ───────────────────────
# This is NOT a user's API key. This is deplo.ai's service account.
# All user backend services are created under deplo.ai's Render account.
#
# How to get:
#   render.com → Account Settings → API Keys → Create API Key
#   Name: "deplo-ai-server-dev"
RENDER_API_KEY=your-render-service-account-api-key
# Render account owner ID — needed for service creation.
# Fetch with: curl -H "Authorization: Bearer $RENDER_API_KEY" https://api.render.com/v1/owners
RENDER_OWNER_ID=your-render-owner-id

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Shared secret used to validate Vercel and Render webhook signatures.
# Optional in dev (validation skipped). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt GitHub access tokens before storing them in the database.
# Must be exactly 64 hex characters (= 32 bytes = AES-256 key).
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate-64-hex-chars-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,https://deplo.ai.taj.works

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | http | debug | silly
LOG_LEVEL=debug
