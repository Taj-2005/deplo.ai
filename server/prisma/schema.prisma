generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  avatarUrl         String?
  githubId          String       @unique
  githubLogin       String       @unique
  githubAccessToken String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  repositories        Repository[]
  deployments         Deployment[]
  providerConnections ProviderConnection[]

  @@index([githubId])
  @@index([email])
  cliTokens CliToken[]
}

model ProviderConnection {
  id                   String   @id @default(cuid())
  userId               String
  provider             String   // "VERCEL" | "RENDER" | "RAILWAY" | "CLOUDFLARE"
  providerUserId       String?
  providerTeamId       String?  // null = personal account
  providerTeamName     String?
  providerAccountName  String?  // display name for the connected account
  installationId       String?
  accessTokenEncrypted String
  metadata             Json     @default("{}")
  status               String   @default("ACTIVE") // "ACTIVE" | "DISCONNECTED"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model Repository {
  id            String  @id @default(cuid())
  userId        String
  githubRepoId  String  @unique
  name          String
  fullName      String
  htmlUrl       String
  cloneUrl      String
  defaultBranch String  @default("main")
  isPrivate     Boolean @default(false)
  language      String?
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  uptimeSamples UptimeSample[]
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([githubRepoId])
}

// Long-lived, revocable tokens for the deplo CLI. Only the SHA-256 hash is
// stored — the raw token (dpl_…) is shown once at creation.
model CliToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Monitoring ────────────────────────────────────────────────────────────────

// One health probe result against a deployed project's live URL.
model UptimeSample {
  id           String   @id @default(cuid())
  repositoryId String
  target       String // "FRONTEND" | "BACKEND"
  url          String
  ok           Boolean
  httpStatus   Int?
  latencyMs    Int?
  checkedAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, checkedAt])
}

// One product-analytics event (pageview) from the opt-in insights snippet.
model AnalyticsEvent {
  id           String   @id @default(cuid())
  repositoryId String
  path         String
  referrer     String?
  visitorHash  String // sha256(ip|ua|day|repo) — daily-unique, no PII stored
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
  @@index([repositoryId, visitorHash, createdAt])
}

model Deployment {
  id              String           @id @default(cuid())
  userId          String
  repositoryId    String
  status          DeploymentStatus @default(PENDING)
  branch          String           @default("main")
  detectedStack   Json?
  envVariables    Json             @default("[]")
  frontendUrl     String?
  backendUrl      String?
  logs            Json             @default("[]")
  vercelProjectId String?
  renderServiceId String?
  renderDeployId  String?
  vercelDeployId  String?
  error           String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([repositoryId])
  @@index([status])
}

enum DeploymentStatus {
  PENDING
  ANALYZING
  WAITING_FOR_ENV
  DEPLOYING_BACKEND
  BACKEND_READY
  DEPLOYING_FRONTEND
  COMPLETED
  FAILED
  CANCELLED
}
