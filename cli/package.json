{
  "name": "@deplo.ai/cli",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Deploy full-stack apps into your own Vercel + Render accounts from the terminal. Code goes in. Production URL comes out.",
  "license": "MIT",
  "homepage": "https://www.deplo.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taj-2005/deplo-ai.git",
    "directory": "cli"
  },
  "keywords": [
    "deploy",
    "deployment",
    "vercel",
    "render",
    "cli",
    "fullstack",
    "devops"
  ],
  "bin": {
    "deplo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.0"
  }
}
